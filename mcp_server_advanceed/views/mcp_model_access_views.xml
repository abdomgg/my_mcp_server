<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mcp_model_access_list" model="ir.ui.view">
            <field name="name">mcp.model.access.list</field>
            <field name="model">mcp.model.access</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="key_id"/>
                    <field name="model_id"/>
                    <field name="can_read"/>
                    <field name="can_create"/>
                    <field name="can_write"/>
                    <field name="can_unlink"/>
                    <field name="max_rows"/>
                    <field name="domain_filter"/>
                </list>
            </field>
        </record>

        <record id="view_mcp_model_access_form" model="ir.ui.view">
            <field name="name">mcp.model.access.form</field>
            <field name="model">mcp.model.access</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="key_id"/>
                                <field name="model_id"/>
                                <field name="max_rows"/>
                            </group>
                            <group string="Permissions">
                                <field name="can_read"/>
                                <field name="can_create"/>
                                <field name="can_write"/>
                                <field name="can_unlink"/>
                            </group>
                        </group>
                        <group string="Restrictions">
                            <field name="field_allow_list"
                                   placeholder="name, email, phone (empty = all readable)"/>
                            <field name="domain_filter"
                                   placeholder="[('state','=','done')]"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mcp_model_access" model="ir.actions.act_window">
            <field name="name">Key Model Access</field>
            <field name="res_model">mcp.model.access</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
