<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mcp_oauth_client_list" model="ir.ui.view">
            <field name="name">mcp.oauth.client.list</field>
            <field name="model">mcp.oauth.client</field>
            <field name="arch" type="xml">
                <list decoration-muted="not active">
                    <field name="name"/>
                    <field name="tenant_id"/>
                    <field name="client_id"/>
                    <field name="template_key_id"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_mcp_oauth_client_form" model="ir.ui.view">
            <field name="name">mcp.oauth.client.form</field>
            <field name="model">mcp.oauth.client</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. Claude.ai"/></h1>
                        </div>
                        <group>
                            <group string="Registration">
                                <field name="tenant_id"/>
                                <field name="client_id"/>
                                <field name="client_secret" password="True"/>
                                <field name="require_pkce"/>
                                <field name="active"/>
                            </group>
                            <group string="Access Template">
                                <field name="template_key_id"/>
                            </group>
                        </group>
                        <separator string="Allowed Redirect URIs"/>
                        <field name="redirect_uris"
                               placeholder="https://claude.ai/api/mcp/auth_callback"/>
                        <div class="text-muted">
                            On authorization, each user gets their own key
                            cloned from the template key's scopes — no shared
                            static secrets, fully audited per person.
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mcp_oauth_client" model="ir.actions.act_window">
            <field name="name">OAuth Clients</field>
            <field name="res_model">mcp.oauth.client</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
