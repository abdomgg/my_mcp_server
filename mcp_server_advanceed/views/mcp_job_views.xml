<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mcp_job_list" model="ir.ui.view">
            <field name="name">mcp.job.list</field>
            <field name="model">mcp.job</field>
            <field name="arch" type="xml">
                <list decoration-danger="state=='failed'"
                      decoration-success="state=='done'"
                      decoration-info="state=='running'" create="false">
                    <field name="create_date"/>
                    <field name="name"/>
                    <field name="tenant_id"/>
                    <field name="job_type"/>
                    <field name="model_name"/>
                    <field name="state"/>
                    <field name="progress" widget="progressbar"/>
                </list>
            </field>
        </record>

        <record id="view_mcp_job_form" model="ir.ui.view">
            <field name="name">mcp.job.form</field>
            <field name="model">mcp.job</field>
            <field name="arch" type="xml">
                <form create="false">
                    <header>
                        <button name="action_cancel" type="object"
                                string="Cancel" class="btn-secondary"
                                invisible="state not in ('queued','running')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="queued,running,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="tenant_id"/>
                                <field name="key_id"/>
                                <field name="job_type"/>
                                <field name="model_name"/>
                            </group>
                            <group>
                                <field name="progress" widget="progressbar"/>
                                <field name="started_at"/>
                                <field name="finished_at"/>
                            </group>
                        </group>
                        <field name="error_message" invisible="not error_message"/>
                        <notebook>
                            <page string="Payload">
                                <field name="payload" widget="ace"/>
                            </page>
                            <page string="Result">
                                <field name="result" widget="ace"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mcp_job" model="ir.actions.act_window">
            <field name="name">Bulk Jobs</field>
            <field name="res_model">mcp.job</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
