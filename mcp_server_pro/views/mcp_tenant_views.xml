<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mcp_tenant_list" model="ir.ui.view">
            <field name="name">mcp.tenant.list</field>
            <field name="model">mcp.tenant</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="slug"/>
                    <field name="api_key_count"/>
                    <field name="rate_limit_per_sec"/>
                    <field name="rate_limit_per_min"/>
                    <field name="is_suspended" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_mcp_tenant_form" model="ir.ui.view">
            <field name="name">mcp.tenant.form</field>
            <field name="model">mcp.tenant</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="is_suspended" widget="boolean_toggle"
                               string="Suspended (kill switch)"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_keys" type="object"
                                    class="oe_stat_button" icon="fa-key">
                                <field name="api_key_count" widget="statinfo"
                                       string="API Keys"/>
                            </button>
                            <button name="action_view_audit_logs" type="object"
                                    class="oe_stat_button" icon="fa-list">
                                <field name="audit_log_count" widget="statinfo"
                                       string="Audit Logs"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Workspace name"/></h1>
                            <field name="slug" placeholder="auto-generated"/>
                        </div>
                        <group>
                            <group string="Isolation">
                                <field name="company_ids" widget="many2many_tags"/>
                                <field name="active"/>
                            </group>
                            <group string="Rate Limits">
                                <field name="rate_limit_per_sec"/>
                                <field name="rate_limit_per_min"/>
                            </group>
                        </group>
                        <field name="description" placeholder="Notes..."/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mcp_tenant" model="ir.actions.act_window">
            <field name="name">Tenants</field>
            <field name="res_model">mcp.tenant</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create your first tenant</p>
                <p>A tenant is an isolated workspace. Keys, logs and jobs all
                   belong to exactly one tenant — a hard data boundary.</p>
            </field>
        </record>

    </data>
</odoo>
