<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mcp_api_key_list" model="ir.ui.view">
            <field name="name">mcp.api.key.list</field>
            <field name="model">mcp.api.key</field>
            <field name="arch" type="xml">
                <list decoration-muted="not active" decoration-danger="is_expired">
                    <field name="name"/>
                    <field name="tenant_id"/>
                    <field name="user_id"/>
                    <field name="active_token_count" string="Active Tokens"/>
                    <field name="request_count"/>
                    <field name="last_used"/>
                    <field name="is_expired" column_invisible="1"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_mcp_api_key_form" model="ir.ui.view">
            <field name="name">mcp.api.key.form</field>
            <field name="model">mcp.api.key</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_open_rotate_wizard" type="object"
                                string="Rotate Token" class="btn-primary"
                                icon="fa-refresh"/>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. Claude — Sales Read"/></h1>
                        </div>
                        <group>
                            <group string="Identity">
                                <field name="tenant_id"/>
                                <field name="user_id"/>
                                <field name="expiration_date"/>
                                <field name="is_expired"/>
                            </group>
                            <group string="Capabilities">
                                <field name="allow_bi_tools"/>
                                <field name="allow_export"/>
                                <field name="allow_batch_async"/>
                                <field name="allow_portal_pages"/>
                                <field name="allow_module_builder"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Model Access" name="access">
                                <field name="model_access_ids">
                                    <list editable="bottom">
                                        <field name="model_id"/>
                                        <field name="can_read"/>
                                        <field name="can_create"/>
                                        <field name="can_write"/>
                                        <field name="can_unlink"/>
                                        <field name="field_allow_list"/>
                                        <field name="domain_filter"/>
                                        <field name="max_rows"/>
                                    </list>
                                </field>
                                <p class="text-muted">
                                    No rows = no access. This is deny-by-default
                                    on top of the run-as user's own ACLs.
                                </p>
                            </page>
                            <page string="Tokens" name="tokens">
                                <field name="token_ids">
                                    <list>
                                        <field name="version"/>
                                        <field name="state"/>
                                        <field name="grace_until"/>
                                        <field name="created_on"/>
                                        <field name="last_used"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Network &amp; Limits" name="network">
                                <group>
                                    <group string="Rate Limit Overrides">
                                        <field name="rate_limit_per_sec"/>
                                        <field name="rate_limit_per_min"/>
                                    </group>
                                    <group string="Audit">
                                        <field name="capture_payloads"/>
                                        <field name="request_count" readonly="1"/>
                                        <field name="last_used" readonly="1"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="ip_allow_list"
                                           placeholder="10.0.0.0/8&#10;203.0.113.5"/>
                                    <field name="ip_deny_list"/>
                                </group>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_mcp_api_key" model="ir.actions.act_window">
            <field name="name">API Keys</field>
            <field name="res_model">mcp.api.key</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Issue your first API key</p>
                <p>A key runs as a chosen Odoo user and is scoped down with
                   per-model grants, field allowlists and domain filters.</p>
            </field>
        </record>

    </data>
</odoo>
